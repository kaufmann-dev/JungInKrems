{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^8.2.0",
        "inertiajs/inertia-laravel": "^3.3.4",
        "laravel/framework": "^13.31.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "thiagoprz/eloquent-composite-key": "^1.0.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7.0",
        "fakerphp/faker": "^1.24.1",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.67.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^13.3.3",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
